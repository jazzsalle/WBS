{
  "permissions": {
    "allow": [
      "Bash(git push)",
      "Bash(git push origin main)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/load_progress.sh\""
          }
        ]
      }
    ]
  }
}
