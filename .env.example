# .env.local 템플릿 — 실제 값은 .env.local(gitignore)에만 둔다.
# C-1: service_role 키는 어떤 env 파일에도 넣지 않는다. publishable(anon) 키만 쓴다.

# Supabase 프로젝트 (대시보드 → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# A-2: 서버 측 이메일 도메인 재검증. 하드코딩 금지 — 미설정이면 인증 가드가
# 명시적 에러로 실패한다. '@' 없이 도메인만 적는다.
ALLOWED_EMAIL_DOMAIN=company.co.kr

# ── 아래는 .env.test.local(gitignore) 전용 — 앱 런타임에서 쓰지 않는다 ──
# 통합 테스트의 시드 적용·검증 SQL·teardown용 pooler 직결 (C-1 단서)
# TEST_DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
